{
  "word": "break",
  "phonetic": "/breɪk/",
  "syllables": [
    "break"
  ],
  "pos": [
    "v.",
    "n."
  ],
  "core_meanings": [
    "打碎",
    "打断",
    "违反",
    "出故障",
    "骨折",
    "休息"
  ],
  "etymology": "源自古英语 brecan，原指“打破、分开”。",
  "semantic_shift": "从实物破裂，引申为规则被打破、过程被中断；休息则是一段工作的中断。",
  "senses": [
    {
      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to separate something into pieces, or to separate into pieces",
      "zh_definition": "使某物碎成几块，或自行碎成几块",
      "usages": [
        {
          "usage_label": "打碎或碎裂",
          "collocations": [
            {
              "phrase": "break a cup",
              "translation": "打碎杯子"
            },
            {
              "phrase": "break a window",
              "translation": "打破窗户"
            }
          ],
          "examples": [
            {
              "en": "I broke a glass.",
              "zh": "我打碎了一个玻璃杯。"
            },
            {
              "en": "The plate broke into three pieces.",
              "zh": "盘子碎成了三块。"
            }
          ]
        }
      ],
      "synonyms": [
        "smash：强调猛烈地砸碎；break 可以只是断裂或损坏。"
      ],
      "antonyms": [
        "fix：修好已经坏掉的东西。"
      ],
      "confusables": [
        "crack：通常只是裂开，不一定完全破碎。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to interrupt the continuous course of something",
      "zh_definition": "打断正在持续的活动或状态",
      "usages": [
        {
          "usage_label": "打断",
          "collocations": [
            {
              "phrase": "break the flow",
              "translation": "打断连贯的过程"
            },
            {
              "phrase": "break someone's concentration",
              "translation": "打断某人的注意力"
            }
          ],
          "examples": [
            {
              "en": "The alarm broke the flow of the lesson.",
              "zh": "警报打断了课堂的连贯进程。"
            },
            {
              "en": "A phone call broke my concentration.",
              "zh": "一通电话打断了我的思路。"
            }
          ]
        }
      ],
      "synonyms": [
        "interrupt：直接表示打断；break 常强调原本连续的状态被打破。"
      ],
      "antonyms": [
        "continue：使活动继续进行。"
      ],
      "confusables": [
        "break the flow 是打断进程，不是把东西砸碎。"
      ]
    },
    {
      "id": 3,
      "part_of_speech": "v.",
      "en_definition": "to act against a rule, law, or promise",
      "zh_definition": "做出违反规则、法律或诺言的事",
      "usages": [
        {
          "usage_label": "违反",
          "collocations": [
            {
              "phrase": "break a rule",
              "translation": "违反规则"
            },
            {
              "phrase": "break the law",
              "translation": "违法"
            }
          ],
          "examples": [
            {
              "en": "You will be punished if you break the rules.",
              "zh": "如果违反规则，你会受到处罚。"
            },
            {
              "en": "The company broke the law.",
              "zh": "那家公司违反了法律。"
            }
          ]
        }
      ],
      "synonyms": [
        "violate：也表示违反规则或法律，语气较正式。"
      ],
      "antonyms": [
        "obey：遵守规则或法律。"
      ],
      "confusables": [
        "break a rule 是违反规则，不是撕毁写有规则的纸。"
      ]
    },
    {
      "id": 4,
      "part_of_speech": "v.",
      "en_definition": "to end a period of silence by making a sound",
      "zh_definition": "通过发声结束一段沉默或安静",
      "usages": [
        {
          "usage_label": "打破沉默",
          "collocations": [
            {
              "phrase": "break the silence",
              "translation": "打破沉默"
            },
            {
              "phrase": "break the quiet",
              "translation": "打破宁静"
            }
          ],
          "examples": [
            {
              "en": "A loud knock broke the silence.",
              "zh": "一声响亮的敲门声打破了沉默。"
            },
            {
              "en": "Her laughter broke the quiet.",
              "zh": "她的笑声打破了宁静。"
            }
          ]
        }
      ],
      "synonyms": [
        "interrupt：可指声音打断安静；break the silence 是更固定的表达。"
      ],
      "antonyms": [
        "remain silent：继续保持沉默。"
      ],
      "confusables": [
        "这里的 break 表示让安静结束，没有东西真的碎掉。"
      ]
    },
    {
      "id": 5,
      "part_of_speech": "v.",
      "en_definition": "to stop working because of a fault",
      "zh_definition": "机器或车辆因故障停止运转",
      "usages": [
        {
          "usage_label": "出故障",
          "collocations": [
            {
              "phrase": "a car breaks down",
              "translation": "汽车抛锚"
            },
            {
              "phrase": "a machine breaks down",
              "translation": "机器出故障"
            }
          ],
          "examples": [
            {
              "en": "Our car broke down on the way home.",
              "zh": "我们的车在回家路上抛锚了。"
            },
            {
              "en": "The washing machine broke down yesterday.",
              "zh": "洗衣机昨天出了故障。"
            }
          ]
        }
      ],
      "synonyms": [
        "fail：也指机器失灵；break down 更常用于车辆和设备。"
      ],
      "antonyms": [
        "work normally：正常运转。"
      ],
      "confusables": [
        "机器 break down 是出故障；人 break down 还可能指情绪崩溃。"
      ]
    },
    {
      "id": 6,
      "part_of_speech": "v.",
      "en_definition": "to fracture a bone",
      "zh_definition": "使骨头断裂",
      "usages": [
        {
          "usage_label": "骨折",
          "collocations": [
            {
              "phrase": "break an arm",
              "translation": "胳膊骨折"
            },
            {
              "phrase": "break a leg",
              "translation": "腿骨折"
            }
          ],
          "examples": [
            {
              "en": "He broke his arm while skating.",
              "zh": "他滑冰时摔断了胳膊。"
            },
            {
              "en": "She broke her leg in the fall.",
              "zh": "她摔倒时腿骨折了。"
            }
          ]
        }
      ],
      "synonyms": [
        "fracture：也指骨折，医疗语境中更常用。"
      ],
      "antonyms": [],
      "confusables": [
        "break a leg 在真实受伤语境中是骨折；作祝福语时还有“祝你好运”的特殊用法。"
      ]
    },
    {
      "id": 7,
      "part_of_speech": "n.",
      "en_definition": "a short rest from work or study",
      "zh_definition": "工作或学习之间的短暂休息",
      "usages": [
        {
          "usage_label": "休息一会儿",
          "collocations": [
            {
              "phrase": "take a break",
              "translation": "休息一下"
            },
            {
              "phrase": "coffee break",
              "translation": "喝咖啡的休息时间"
            }
          ],
          "examples": [
            {
              "en": "Let's take a break.",
              "zh": "我们休息一下吧。"
            },
            {
              "en": "I need a short break.",
              "zh": "我需要短暂休息。"
            }
          ]
        }
      ],
      "synonyms": [
        "rest：泛指休息；break 常指工作或学习中的短暂停顿。"
      ],
      "antonyms": [
        "work：与休息相对的活动。"
      ],
      "confusables": [
        "a break 是“一次休息”；break 作动词还可表示“打破”。"
      ]
    },
    {
      "id": 8,
      "part_of_speech": "v.",
      "en_definition": "to end a relationship",
      "zh_definition": "结束一段关系",
      "usages": [
        {
          "usage_label": "分手",
          "collocations": [
            {
              "phrase": "break up",
              "translation": "分手"
            },
            {
              "phrase": "break up with someone",
              "translation": "和某人分手"
            }
          ],
          "examples": [
            {
              "en": "They broke up last month.",
              "zh": "他们上个月分手了。"
            },
            {
              "en": "She broke up with Tom.",
              "zh": "她和汤姆分手了。"
            }
          ]
        }
      ],
      "synonyms": [
        "split up：同样可说伴侣分手。"
      ],
      "antonyms": [
        "get together：开始在一起。"
      ],
      "confusables": [
        "break up 是分手；break down 是故障或情绪崩溃。"
      ]
    },
    {
      "id": 9,
      "part_of_speech": "v.",
      "en_definition": "to enter a place by force",
      "zh_definition": "强行进入某处",
      "usages": [
        {
          "usage_label": "闯入",
          "collocations": [
            {
              "phrase": "break into a house",
              "translation": "闯入房屋"
            },
            {
              "phrase": "break in",
              "translation": "强行进入"
            }
          ],
          "examples": [
            {
              "en": "Someone broke into our house.",
              "zh": "有人闯进了我们家。"
            },
            {
              "en": "A thief broke in last night.",
              "zh": "昨晚有小偷闯入。"
            }
          ]
        }
      ],
      "synonyms": [
        "force one's way in：强调强行进去。"
      ],
      "antonyms": [],
      "confusables": [
        "break into 是闯入；break in 也可指穿新鞋使其合脚。"
      ]
    }
  ]
}
