      "part_of_speech": "v.",
      "en_definition": "to recover from illness or trouble",
      "zh_definition": "从疾病或困难中恢复",
      "usages": [
        {
          "usage_label": "克服或恢复",
          "collocations": [
            {
              "phrase": "get over a cold",
              "translation": "感冒痊愈"
            },
            {
              "phrase": "get over a loss",
              "translation": "从失去某人或某物的打击中恢复"
            }
          ],
          "examples": [
            {
              "en": "She got over her cold.",
              "zh": "她的感冒好了。"
            },
            {
              "en": "It took her months to get over the loss of her dog.",
              "zh": "她花了几个月才从失去爱犬的悲痛中走出来。"
            }
          ]
        }
      ],
      "synonyms": [
