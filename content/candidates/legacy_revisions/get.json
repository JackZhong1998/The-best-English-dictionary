              "phrase": "get off the bus",
              "translation": "下公交车"
            }
          ],
          "examples": [
            {
              "en": "We got off the bus.",
              "zh": "我们下了公交车。"
            },
            {
              "en": "Please get out now.",
              "zh": "请现在出去。"
            }
          ]
        }
      ],
      "synonyms": [
        "leave：离开；get off 专指从公交等交通工具下来。"
      ],
      "antonyms": [
