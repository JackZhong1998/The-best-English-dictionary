      "part_of_speech": "v.",
      "en_definition": "to rise from bed after sleeping",
      "zh_definition": "睡醒后起床",
      "usages": [
        {
          "usage_label": "起床",
          "collocations": [
            {
              "phrase": "get up early",
              "translation": "早起"
            },
            {
              "phrase": "get up at six",
              "translation": "六点起床"
            }
          ],
          "examples": [
            {
              "en": "I get up at six on school days.",
              "zh": "上学的日子我六点起床。"
            },
            {
              "en": "She got up early to catch the train.",
              "zh": "她早起赶火车。"
            }
          ]
        }
