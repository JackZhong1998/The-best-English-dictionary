          "collocations": [
            {
              "phrase": "get along well",
              "translation": "相处得好"
            },
            {
              "phrase": "get along with",
              "translation": "与……相处"
            }
          ],
          "examples": [
            {
              "en": "They get along well.",
              "zh": "他们相处得很好。"
            },
            {
              "en": "I get along with my sister.",
              "zh": "我和姐姐相处得很好。"
            }
          ]
        }
      ],
      "synonyms": [
