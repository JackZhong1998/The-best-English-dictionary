      "part_of_speech": "v.",
      "en_definition": "to return to a place",
      "zh_definition": "回到某地",
      "usages": [
        {
          "usage_label": "回来",
          "collocations": [
            {
              "phrase": "get back home",
              "translation": "回到家"
            },
            {
              "phrase": "get back soon",
              "translation": "快点回来"
            }
          ],
          "examples": [
            {
              "en": "I got back late.",
              "zh": "我回来晚了。"
            },
            {
              "en": "When did you get back?",
              "zh": "你什么时候回来的？"
            }
          ]
        }
      ],
      "synonyms": [
        "return：回来；get back 更口语。"
      ],
      "antonyms": [
        "leave：离开。"
      ],
      "confusables": [
        "get back 是回来；give back 是归还。"
      ]
    },
    {
