      ],
      "confusables": [
        "get off the bus 是下公交；get out of a car 是下汽车。"
      ]
    },
    {
      "id": 7,
      "part_of_speech": "v.",
      "en_definition": "to enter a vehicle",
      "zh_definition": "进入交通工具",
      "usages": [
        {
          "usage_label": "上车",
          "collocations": [
            {
              "phrase": "get on the bus",
              "translation": "上公交车"
            },
            {
              "phrase": "get in a car",
              "translation": "上汽车"
            }
          ],
          "examples": [
            {
              "en": "Get on the bus now.",
              "zh": "现在上公交车。"
            },
            {
              "en": "She got in the car.",
              "zh": "她上了车。"
            }
          ]
        }
      ],
      "synonyms": [
        "board：登上交通工具，语气较正式。"
      ],
      "antonyms": [
        "get off：下车。"
      ],
      "confusables": [
        "get on a bus；get in a car，介词通常不同。"
      ]
    },
    {
