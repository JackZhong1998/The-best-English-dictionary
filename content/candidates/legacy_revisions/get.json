{
  "word": "get",
  "phonetic": "/ɡet/",
  "syllables": [
    "get"
  ],
  "pos": [
    "v."
  ],
  "core_meanings": [
    "得到",
    "到达",
    "变得",
    "理解",
    "起床"
  ],
  "etymology": "主要源自古诺尔斯语 geta，早已有“得到、到达”等多种用法。",
  "semantic_shift": "“取得”是常见起点；得到位置可说“到达”，得到某种状态可说“变得”，理解则像“抓住”意思。",
  "senses": [
    {
      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to receive or obtain something",
      "zh_definition": "收到或得到某物",
      "usages": [
        {
          "usage_label": "得到",
          "collocations": [
            {
              "phrase": "get a gift",
              "translation": "收到礼物"
            },
            {
              "phrase": "get a job",
              "translation": "找到工作"
            }
          ],
          "examples": [
            {
              "en": "I got a letter today.",
              "zh": "我今天收到一封信。"
            },
            {
              "en": "She got a new job.",
              "zh": "她找到了一份新工作。"
            }
          ]
        }
      ],
      "synonyms": [
        "obtain：强调取得；get 更常用也更口语。"
      ],
      "antonyms": [
        "lose：失去。"
      ],
      "confusables": [
        "get 可指得到；give 是把东西给别人。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to reach a place",
      "zh_definition": "到达某地",
      "usages": [
        {
          "usage_label": "到达",
          "collocations": [
            {
              "phrase": "get home",
              "translation": "到家"
            },
            {
              "phrase": "get to school",
              "translation": "到学校"
            }
          ],
          "examples": [
            {
              "en": "We got home at six.",
              "zh": "我们六点到家。"
            },
            {
              "en": "How did you get here?",
              "zh": "你怎么到这里的？"
            }
          ]
        }
      ],
      "synonyms": [
        "arrive：强调到达；get to 强调抵达目的地。"
      ],
      "antonyms": [
        "leave：离开。"
      ],
      "confusables": [
        "get to school 是到学校；go to school 是去学校。"
      ]
    },
    {
      "id": 3,
      "part_of_speech": "v.",
      "en_definition": "to become a particular way",
      "zh_definition": "变成某种状态",
      "usages": [
        {
          "usage_label": "变得",
          "collocations": [
            {
              "phrase": "get tired",
              "translation": "累了"
            },
            {
              "phrase": "get cold",
              "translation": "变冷"
            }
          ],
          "examples": [
            {
              "en": "I get tired after work.",
              "zh": "我下班后会累。"
            },
            {
              "en": "It gets cold at night.",
              "zh": "晚上会变冷。"
            }
          ]
        }
      ],
      "synonyms": [
        "become：变成某种状态；get 在日常口语中很常见。"
      ],
      "antonyms": [
        "stay：保持原状态。"
      ],
      "confusables": [
        "get cold 是变冷；be cold 是已经冷。"
      ]
    },
    {
      "id": 4,
      "part_of_speech": "v.",
      "en_definition": "to understand something",
      "zh_definition": "理解某事",
      "usages": [
        {
          "usage_label": "明白",
          "collocations": [
            {
              "phrase": "get the joke",
              "translation": "听懂笑话"
            },
            {
              "phrase": "get the idea",
              "translation": "明白意思"
            }
          ],
          "examples": [
            {
              "en": "I don't get the joke.",
              "zh": "我没听懂这个笑话。"
            },
            {
              "en": "Now I get it.",
              "zh": "现在我明白了。"
            }
          ]
        }
      ],
      "synonyms": [
        "understand：理解；get it 更口语。"
      ],
      "antonyms": [
        "misunderstand：误解。"
      ],
      "confusables": [
        "get the joke 是听懂笑话，不是得到笑话。"
      ]
    },
    {
      "id": 5,
      "part_of_speech": "v.",
      "en_definition": "to bring or buy something for someone",
      "zh_definition": "为某人拿来或购买某物",
      "usages": [
        {
          "usage_label": "拿来或买来",
          "collocations": [
            {
              "phrase": "get some water",
              "translation": "拿些水"
            },
            {
              "phrase": "get a ticket",
              "translation": "买票"
            }
          ],
          "examples": [
            {
              "en": "Can you get me some water?",
              "zh": "你能给我拿些水吗？"
            },
            {
              "en": "I got two tickets for my parents.",
              "zh": "我给父母买了两张票。"
            }
          ]
        }
      ],
      "synonyms": [
        "fetch：去取来；get 也能表示买来。"
      ],
      "antonyms": [
        "take away：拿走。"
      ],
      "confusables": [
        "get me water 是给我拿水；give me water 是把水给我。"
      ]
    },
    {
