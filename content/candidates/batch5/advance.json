            {
              "phrase": "a major advance",
              "translation": "重大进展"
            }
          ],
          "examples": [
            {
              "en": "This was a major advance in treatment.",
              "zh": "这是治疗方面的一项重大进展。"
            },
            {
              "en": "We have seen advances in technology.",
              "zh": "我们见证了技术进步。"
            }
          ]
        }
      ],
      "synonyms": [
