    {
      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to move forward",
      "zh_definition": "向前移动",
      "usages": [
        {
          "usage_label": "前进",
          "collocations": [
            {
              "phrase": "advance slowly",
              "translation": "缓慢前进"
            },
            {
              "phrase": "advance toward the city",
              "translation": "向城市推进"
            }
          ],
          "examples": [
            {
              "en": "The soldiers advanced slowly.",
              "zh": "士兵们缓慢前进。"
            },
            {
              "en": "The crowd advanced toward the gate.",
              "zh": "人群向大门走去。"
            }
          ]
        }
      ],
      "synonyms": [
        "move forward：更日常；advance 稍正式。"
      ],
      "antonyms": [
        "retreat：后退。"
      ],
      "confusables": [
        "advance toward 后接前进的目标。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to help an idea or plan develop",
      "zh_definition": "推动想法或计划向前发展",
      "usages": [
        {
          "usage_label": "推动",
          "collocations": [
            {
              "phrase": "advance a plan",
              "translation": "推进计划"
            },
            {
              "phrase": "advance research",
              "translation": "推动研究"
            }
          ],
          "examples": [
            {
              "en": "The new funding advanced the project.",
              "zh": "新资金推动了项目进展。"
            },
            {
              "en": "Her work advanced our understanding.",
              "zh": "她的工作增进了我们的理解。"
            }
          ]
        }
      ],
      "synonyms": [
