      ]
    },
    {
      "id": 4,
      "part_of_speech": "v.",
      "en_definition": "to make someone suddenly worried or frightened",
      "zh_definition": "使某人突然担忧或害怕",
      "usages": [
        {
          "usage_label": "使惊恐",
          "collocations": [
            {
              "phrase": "alarm the family",
              "translation": "使家人惊慌"
            },
            {
              "phrase": "be alarmed by",
              "translation": "因……而惊慌"
            }
          ],
          "examples": [
            {
              "en": "The loud noise alarmed the children.",
              "zh": "巨响吓到了孩子们。"
            },
            {
              "en": "We were alarmed by the smoke.",
              "zh": "看到烟雾，我们很惊慌。"
            }
          ]
        }
      ],
      "synonyms": [
        "frighten：强调害怕；alarm 也包含对危险的担忧。"
      ],
      "antonyms": [
        "reassure：使人安心。"
      ],
      "confusables": [
