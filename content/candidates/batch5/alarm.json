      ]
    },
    {
      "id": 2,
      "part_of_speech": "n.",
      "en_definition": "a device that wakes someone at a set time",
      "zh_definition": "在设定时间叫醒人的装置",
      "usages": [
        {
          "usage_label": "闹钟",
          "collocations": [
            {
              "phrase": "set an alarm",
              "translation": "设闹钟"
            },
            {
              "phrase": "turn off the alarm",
              "translation": "关掉闹钟"
            }
          ],
          "examples": [
            {
              "en": "My alarm rang at six.",
              "zh": "我的闹钟六点响了。"
            },
            {
              "en": "The alarm woke me up early.",
              "zh": "闹钟很早就把我叫醒了。"
            }
          ]
        }
      ],
      "synonyms": [
        "alarm clock：专指叫醒人的闹钟；alarm 也可指警报。"
      ],
      "antonyms": [],
      "confusables": [
        "set an alarm for seven 表示设在七点响。",
        "clock 只需显示时间，不一定能在设定时间叫醒人。"
      ]
    },
    {
      "id": 3,
      "part_of_speech": "n.",
      "en_definition": "a sudden feeling of worry or fear",
      "zh_definition": "突然产生的担忧或害怕",
      "usages": [
        {
          "usage_label": "惊恐或担忧",
          "collocations": [
            {
              "phrase": "cause alarm",
              "translation": "引起恐慌"
            },
            {
              "phrase": "look with alarm",
              "translation": "惊恐地看"
            }
          ],
          "examples": [
            {
              "en": "The news caused alarm among parents.",
              "zh": "这个消息让家长们感到担忧。"
            },
            {
              "en": "She looked at the smoke with alarm.",
              "zh": "她惊恐地看着烟雾。"
            }
          ]
        }
      ],
      "synonyms": [
        "fear：泛指害怕；alarm 常是对突然危险的反应。"
      ],
      "antonyms": [
        "calm：平静。"
      ],
      "confusables": [
