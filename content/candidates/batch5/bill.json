    {
      "id": 5,
      "part_of_speech": "v.",
      "en_definition": "to send someone a request for payment",
      "zh_definition": "向某人开账单要求付款",
      "usages": [
        {
          "usage_label": "开账单或收费",
          "collocations": [
            {
              "phrase": "bill a customer",
              "translation": "给顾客开账单"
            },
            {
              "phrase": "bill someone for a service",
              "translation": "向某人收取服务费"
            }
          ],
          "examples": [
            {
              "en": "The hotel billed us for two nights.",
              "zh": "酒店向我们收取了两晚的住宿费。"
            },
            {
              "en": "The company billed the customer for the repair.",
              "zh": "公司向顾客收取了维修费。"
            }
          ]
        }
      ],
      "synonyms": [
        "charge：也表示收费；bill 强调列出并要求支付款项。"
      ],
      "antonyms": [],
      "confusables": [
        "bill someone for something 中的 for 引出收费项目。"
      ]
    }
