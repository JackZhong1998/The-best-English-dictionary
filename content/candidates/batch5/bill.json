    {
      "id": 1,
      "part_of_speech": "n.",
      "en_definition": "a written statement of money you owe",
      "zh_definition": "列明应付款项的单据",
      "usages": [
        {
          "usage_label": "账单",
          "collocations": [
            {
              "phrase": "pay the bill",
              "translation": "付账"
            },
            {
              "phrase": "an electricity bill",
              "translation": "电费账单"
            }
          ],
          "examples": [
            {
              "en": "We paid the bill after dinner.",
              "zh": "我们饭后付了账。"
            },
            {
              "en": "The electricity bill arrived today.",
              "zh": "电费账单今天寄到了。"
            }
          ]
        }
      ],
      "synonyms": [
        "invoice：商业交易中的付款单据；bill 也可指餐馆账单。"
      ],
      "antonyms": [],
      "confusables": [
        "pay the bill 指付账，不是支付法案。",
        "receipt 是付款后拿到的收据；bill 是待支付的账单。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "n.",
      "en_definition": "a piece of paper money, especially in American English",
      "zh_definition": "纸币，尤见于美式英语",
      "usages": [
        {
          "usage_label": "钞票",
          "collocations": [
            {
              "phrase": "a ten-dollar bill",
              "translation": "一张十美元钞票"
            },
            {
              "phrase": "a hundred-dollar bill",
              "translation": "一张百元钞票"
            }
          ],
          "examples": [
            {
              "en": "She gave me a ten-dollar bill.",
              "zh": "她给了我一张十美元钞票。"
            },
            {
              "en": "I only have a hundred-dollar bill.",
              "zh": "我只有一张百元钞票。"
            }
          ]
        }
      ],
      "synonyms": [
        "banknote：较正式的纸币说法。"
      ],
      "antonyms": [
        "coin：硬币。"
      ],
      "confusables": [
        "a bill 在美国英语中可指纸币；英国英语多说 note。"
      ]
    },
    {
      "id": 3,
      "part_of_speech": "n.",
      "en_definition": "a proposed law being discussed by lawmakers",
      "zh_definition": "立法机构正在讨论的法律草案",
      "usages": [
        {
          "usage_label": "法案",
          "collocations": [
            {
              "phrase": "pass a bill",
              "translation": "通过法案"
            },
            {
              "phrase": "introduce a bill",
              "translation": "提出法案"
            }
          ],
          "examples": [
            {
              "en": "Lawmakers discussed the new bill.",
              "zh": "立法者讨论了新法案。"
            },
            {
              "en": "The committee introduced a bill on housing.",
              "zh": "委员会提出了一项住房法案。"
            }
          ]
        }
      ],
      "synonyms": [
        "proposed law：拟议中的法律，与 bill 同指尚未通过的法案。"
      ],
      "antonyms": [
