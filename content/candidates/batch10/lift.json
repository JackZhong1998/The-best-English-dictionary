      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to raise something to a higher position",
      "zh_definition": "把某物举到更高处",
      "usages": [
        {
          "usage_label": "举起",
          "collocations": [
            {
              "phrase": "lift a box",
              "translation": "抬起箱子"
            },
            {
              "phrase": "lift your hand",
              "translation": "举手"
            }
          ],
          "examples": [
            {
              "en": "Can you lift this heavy box?",
              "zh": "你能抬起这个重箱子吗？"
            },
            {
              "en": "She lifted her hand to ask a question.",
              "zh": "她举手提问。"
            }
          ]
        }
      ],
      "synonyms": [
        "raise：也指抬高；lift 常强调克服重量向上举。"
      ],
      "antonyms": [
        "lower：放低。"
      ],
      "confusables": [
        "lift up 常与 lift 意思接近。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to remove a rule or restriction",
      "zh_definition": "解除规则或限制",
      "usages": [
        {
          "usage_label": "解除",
          "collocations": [
            {
              "phrase": "lift a ban",
              "translation": "解除禁令"
            },
            {
              "phrase": "lift restrictions",
              "translation": "解除限制"
            }
          ],
          "examples": [
            {
              "en": "The city lifted the parking ban.",
              "zh": "市政府取消了停车禁令。"
            },
            {
              "en": "They lifted the travel restrictions.",
              "zh": "他们解除了旅行限制。"
            }
          ]
        }
      ],
      "synonyms": [
        "remove：泛指移除；lift 常搭配 ban 或 restrictions。"
      ],
      "antonyms": [],
      "confusables": [
        "此义不涉及物理上的举高。"
      ]
    },
