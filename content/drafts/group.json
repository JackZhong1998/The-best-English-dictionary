        "team：通常为共同目标协作；group 不一定如此。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to put people or things into sets",
      "zh_definition": "把人或事物分成若干组",
      "usages": [
        {
          "usage_label": "分组",
          "collocations": [
            {
              "phrase": "group by age",
              "translation": "按年龄分组"
            },
            {
              "phrase": "group the books",
              "translation": "把书分类"
            }
          ],
          "examples": [
            {
              "en": "The teacher grouped us by age.",
              "zh": "老师按年龄给我们分组。"
            },
            {
              "en": "We grouped the books by topic.",
              "zh": "我们按主题给书分类。"
            }
          ]
        }
      ],
      "synonyms": [
        "classify：侧重按类别分类；group 更通用。"
      ],
      "antonyms": [
        "separate：使分开，未必再组成组。"
      ],
