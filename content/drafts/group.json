      "en_definition": "several people or things considered together",
      "zh_definition": "被看作一个整体的若干人或物",
      "usages": [
        {
          "usage_label": "群体",
          "collocations": [
            {
              "phrase": "a group of students",
              "translation": "一群学生"
            },
            {
              "phrase": "a small group",
              "translation": "一个小组"
            }
          ],
          "examples": [
            {
              "en": "A group of students entered the room.",
              "zh": "一群学生走进房间。"
            },
            {
              "en": "We worked in a small group.",
              "zh": "我们在一个小组里合作。"
            }
          ]
        }
      ],
      "synonyms": [
        "无完全同义：group 是被看作整体的一群人或事物。"
      ],
      "antonyms": [
        "individual：个人。"
      ],
      "confusables": [
