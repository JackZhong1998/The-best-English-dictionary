      "usages": [
        {
          "usage_label": "十字形",
          "collocations": [
            {
              "phrase": "draw a cross",
              "translation": "画十字"
            },
            {
              "phrase": "mark with a cross",
              "translation": "用十字标记"
            }
          ],
          "examples": [
            {
              "en": "Draw a cross beside your choice.",
              "zh": "在你的选项旁画个十字。"
            },
            {
              "en": "The sign shows a red cross.",
              "zh": "标志上有一个红十字。"
            }
          ]
        }
      ],
      "synonyms": [
        "无完全同义：cross 是两条线相交形成的十字形。"
      ],
      "antonyms": [],
      "confusables": [
        "a cross 可指十字形，不一定指宗教符号。",
        "X 可指字母或相似的形状，不是 cross 的词汇近义词。"
      ]
