              "translation": "到达伦敦"
            }
          ],
          "examples": [
            {
              "en": "The train arrived at noon.",
              "zh": "火车中午到站。"
            },
            {
              "en": "We arrived in London yesterday.",
              "zh": "我们昨天抵达伦敦。"
            }
          ]
        }
      ],
      "synonyms": [
