      "usages": [
        {
          "usage_label": "生长",
          "collocations": [
            {
              "phrase": "grow quickly",
              "translation": "长得快"
            },
            {
              "phrase": "grow tall",
              "translation": "长高"
            }
          ],
          "examples": [
            {
              "en": "The child grew quickly last year.",
              "zh": "那个孩子去年长得很快。"
            },
            {
              "en": "These trees grow slowly.",
              "zh": "这些树长得很慢。"
            }
          ]
        }
      ],
      "synonyms": [
        "develop：也指发育，强调逐渐变化。"
      ],
      "antonyms": [
