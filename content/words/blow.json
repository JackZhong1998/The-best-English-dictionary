      "usages": [
        {
          "usage_label": "吹",
          "collocations": [
            {
              "phrase": "blow on soup",
              "translation": "对着汤吹气"
            },
            {
              "phrase": "blow out a candle",
              "translation": "吹灭蜡烛"
            }
          ],
          "examples": [
            {
              "en": "Blow on the soup before you eat it.",
              "zh": "吃汤前先吹一吹。"
            },
            {
