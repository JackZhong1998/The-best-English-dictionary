  "senses": [
    {
      "id": 1,
      "part_of_speech": "n.",
      "en_definition": "a quality that attracts people",
      "zh_definition": "吸引人的特质",
      "usages": [
        {
          "usage_label": "吸引力",
          "collocations": [
            {
              "phrase": "have wide appeal",
              "translation": "广受欢迎"
            },
            {
              "phrase": "the appeal of a place",
              "translation": "一个地方的吸引力"
            }
          ],
          "examples": [
            {
              "en": "The town has great appeal for tourists.",
              "zh": "这座小镇对游客很有吸引力。"
            },
            {
              "en": "I understand the appeal of living here.",
              "zh": "我明白住在这里有什么吸引力。"
            }
          ]
        }
      ],
      "synonyms": [
        "attraction：也指吸引力；appeal 常指让人愿意选择某物的特点。"
      ],
      "antonyms": [],
      "confusables": [
        "have appeal for someone 表示对某人有吸引力。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to attract or interest someone",
      "zh_definition": "引起某人的兴趣",
      "usages": [
        {
          "usage_label": "吸引",
          "collocations": [
            {
              "phrase": "appeal to children",
              "translation": "吸引儿童"
            },
            {
              "phrase": "appeal to many people",
              "translation": "吸引许多人"
            }
          ],
          "examples": [
            {
              "en": "The idea appeals to me.",
              "zh": "这个主意很吸引我。"
            },
            {
              "en": "This game appeals to young children.",
              "zh": "这个游戏很吸引年幼的孩子。"
            }
          ]
        }
      ],
      "synonyms": [
        "attract：强调吸引；appeal to 常表示符合兴趣或喜好。"
      ],
      "antonyms": [],
      "confusables": [
        "appeal to 后接被吸引的人。"
      ]
    },
    {
      "id": 3,
      "part_of_speech": "n.",
      "en_definition": "a serious public request for help",
