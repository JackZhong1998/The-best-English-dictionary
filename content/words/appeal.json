        {
          "usage_label": "呼吁",
          "collocations": [
            {
              "phrase": "make an appeal",
              "translation": "发出呼吁"
            },
            {
              "phrase": "an appeal for help",
              "translation": "求助呼吁"
            }
          ],
          "examples": [
            {
              "en": "The group made an appeal for food.",
              "zh": "这个团体呼吁捐赠食物。"
            },
            {
              "en": "Her appeal for help reached many people.",
              "zh": "她的求助呼吁传到了许多人那里。"
            }
          ]
        }
      ],
      "synonyms": [
        "request：一般请求；appeal 常较紧急或公开。"
      ],
      "antonyms": [],
      "confusables": [
        "an appeal for 后接所请求的东西。"
      ]
    },
    {
      "id": 4,
      "part_of_speech": "v.",
      "en_definition": "to make a serious public request for help or support",
      "zh_definition": "公开而郑重地请求帮助或支持",
      "usages": [
        {
          "usage_label": "呼吁",
          "collocations": [
            {
              "phrase": "appeal for help",
              "translation": "呼吁援助"
            },
            {
              "phrase": "appeal to the public",
              "translation": "向公众呼吁"
            }
          ],
          "examples": [
            {
              "en": "The charity appealed for help after the storm.",
              "zh": "风暴过后，这家慈善机构呼吁援助。"
            },
            {
              "en": "The police appealed to the public for information.",
              "zh": "警方呼吁公众提供信息。"
            }
          ]
        }
      ],
      "synonyms": [
        "ask：泛指请求；appeal 常是公开、郑重的呼吁。"
      ],
      "antonyms": [],
      "confusables": [
        "appeal to someone for something 表示向某人请求某物。"
      ]
    },
    {
      "id": 5,
      "part_of_speech": "v.",
      "en_definition": "to ask a higher court to change a decision",
      "zh_definition": "请求上级法院改变裁决",
      "usages": [
        {
          "usage_label": "上诉",
          "collocations": [
            {
              "phrase": "appeal a decision",
              "translation": "对裁决提出上诉"
            },
            {
              "phrase": "appeal to a higher court",
              "translation": "向上级法院上诉"
            }
          ],
          "examples": [
            {
              "en": "The lawyer appealed the decision.",
              "zh": "律师对这项裁决提出了上诉。"
            },
            {
              "en": "She appealed to a higher court.",
              "zh": "她向上级法院提出了上诉。"
            }
          ]
        }
      ],
      "synonyms": [
        "challenge：泛指质疑；appeal 在法律中指正式上诉。"
      ],
      "antonyms": [
        "accept the ruling：接受裁决。"
      ],
      "confusables": [
        "法律义的 appeal 与吸引力无关，需按语境判断。"
      ]
    }
