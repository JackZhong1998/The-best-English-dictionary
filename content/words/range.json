      "usages": [
        {
          "usage_label": "范围",
          "collocations": [
            {
              "phrase": "an age range",
              "translation": "年龄范围"
            },
            {
              "phrase": "a wide price range",
              "translation": "很大的价格跨度"
            }
          ],
          "examples": [
            {
              "en": "The age range is six to ten.",
              "zh": "年龄范围是六到十岁。"
            },
            {
