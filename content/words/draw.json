{
  "word": "draw",
  "phonetic": "/drɔː/",
  "syllables": [
    "draw"
  ],
  "pos": [
    "v.",
    "n."
  ],
  "core_meanings": [
    "画",
    "拉",
    "吸引",
    "平局"
  ],
  "etymology": "源自古英语 dragan，原有“拉、拖”之意。",
  "semantic_shift": "先是“拉动”；画画可理解为笔在纸上拉出线条，吸引注意力则是比喻性的“拉过来”。",
  "senses": [
    {
      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to make a picture with a pen or pencil",
      "zh_definition": "用笔画图",
      "usages": [
        {
          "usage_label": "画画",
          "collocations": [
            {
              "phrase": "draw a picture",
              "translation": "画一幅画"
            },
            {
              "phrase": "draw a map",
              "translation": "画地图"
            }
          ],
          "examples": [
            {
              "en": "She drew a cat.",
              "zh": "她画了一只猫。"
            },
            {
              "en": "Please draw a line.",
              "zh": "请画一条线。"
            }
          ]
        }
      ],
      "synonyms": [
        "sketch：多指快速画出轮廓；draw 更宽泛。"
      ],
      "antonyms": [
        "erase：擦掉画出的东西。"
      ],
      "confusables": [
        "draw 用笔画；paint 常用颜料涂画。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to pull something toward you or in a direction",
      "zh_definition": "将某物拉向自己或某方向",
      "usages": [
        {
          "usage_label": "拉或拖",
          "collocations": [
            {
              "phrase": "draw the curtains",
              "translation": "拉窗帘"
            },
            {
              "phrase": "draw a chair closer",
              "translation": "把椅子拉近"
            }
          ],
          "examples": [
            {
              "en": "He drew the curtains.",
              "zh": "他拉上了窗帘。"
            },
            {
              "en": "She drew her chair closer.",
              "zh": "她把椅子拉近了。"
            }
          ]
        }
      ],
      "synonyms": [
        "pull：拉；draw 常显得较书面。"
      ],
      "antonyms": [
        "push：朝远离自己的方向推。"
      ],
      "confusables": [
        "draw the curtains 是拉窗帘，不是画窗帘。"
      ]
    },
    {
      "id": 3,
      "part_of_speech": "v.",
      "en_definition": "to attract people or attention",
      "zh_definition": "吸引人或注意力",
      "usages": [
        {
          "usage_label": "吸引",
          "collocations": [
            {
              "phrase": "draw a crowd",
              "translation": "吸引人群"
            },
            {
              "phrase": "draw attention",
              "translation": "引起注意"
            }
          ],
          "examples": [
            {
              "en": "The music drew a crowd.",
              "zh": "音乐吸引了一群人。"
            },
            {
              "en": "The sign drew my attention.",
              "zh": "标志引起了我的注意。"
            }
          ]
        }
      ],
      "synonyms": [
        "attract：吸引；draw attention 是固定搭配。"
      ],
      "antonyms": [
        "repel：使人远离。"
      ],
      "confusables": [
        "draw a crowd 是吸引人群，不是画一群人。"
      ]
    },
    {
      "id": 4,
      "part_of_speech": "v.",
      "en_definition": "to take money from an account",
      "zh_definition": "从账户取出钱",
      "usages": [
        {
          "usage_label": "提取",
          "collocations": [
            {
              "phrase": "draw money",
              "translation": "取钱"
            },
            {
              "phrase": "draw cash",
              "translation": "提取现金"
            }
          ],
          "examples": [
            {
              "en": "I drew cash at the bank.",
              "zh": "我在银行取了现金。"
            },
            {
              "en": "She drew some money today.",
              "zh": "她今天取了一些钱。"
            }
          ]
        }
      ],
      "synonyms": [
        "withdraw：从账户提款，比 draw money 更明确。"
      ],
      "antonyms": [
        "deposit：把钱存入账户。"
      ],
      "confusables": [
        "draw cash 是取现；draw a picture 是画画。"
      ]
    },
    {
      "id": 5,
      "part_of_speech": "n.",
      "en_definition": "a game with no winner",
      "zh_definition": "没有赢家的比赛",
      "usages": [
        {
          "usage_label": "平局",
          "collocations": [
            {
              "phrase": "end in a draw",
              "translation": "以平局结束"
            },
            {
              "phrase": "a one-one draw",
              "translation": "一比一平"
            }
          ],
          "examples": [
            {
              "en": "The game ended in a draw.",
              "zh": "比赛以平局结束。"
            },
            {
              "en": "It was a draw again.",
              "zh": "又是一场平局。"
            }
          ]
        }
      ],
      "synonyms": [
        "tie：比赛打平；draw 是比赛结果的名词。"
      ],
      "antonyms": [
        "win：赢得比赛。"
      ],
      "confusables": [
        "a draw 是平局；draw 作动词还可表示画或拉。"
      ]
    },
    {
      "id": 6,
      "part_of_speech": "v.",
      "en_definition": "to reach an idea after thinking",
      "zh_definition": "思考后得出想法",
      "usages": [
        {
          "usage_label": "得出结论",
          "collocations": [
            {
              "phrase": "draw a conclusion",
              "translation": "得出结论"
            },
            {
              "phrase": "draw a lesson",
              "translation": "吸取教训"
            }
          ],
          "examples": [
            {
              "en": "We drew a simple conclusion.",
              "zh": "我们得出了一个简单的结论。"
            },
            {
              "en": "She drew a lesson from it.",
              "zh": "她从中吸取了教训。"
            }
          ]
        }
      ],
      "synonyms": [
        "conclude：得出结论；draw a conclusion 突出由材料推到结果。"
      ],
      "antonyms": [],
