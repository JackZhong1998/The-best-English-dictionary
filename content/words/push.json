    {
      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to move something away by using force",
      "zh_definition": "用力使某物远离自己",
      "usages": [
        {
          "usage_label": "推",
          "collocations": [
            {
              "phrase": "push the door",
              "translation": "推门"
            },
            {
              "phrase": "push a cart",
              "translation": "推车"
            }
          ],
          "examples": [
            {
              "en": "Push the door to enter.",
              "zh": "推门进去。"
            },
            {
              "en": "He pushed the cart down the aisle.",
              "zh": "他推着车走过通道。"
            }
          ]
        }
      ],
      "synonyms": [
        "shove：也指推，通常更猛、更粗鲁。"
      ],
      "antonyms": [
        "pull：拉，与推的方向相反。"
      ],
      "confusables": [
        "push 和 pull 方向相反。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to urge someone to work or act harder",
