  "etymology": "直接来自拉丁语 area“平地、空地”；更早来源不确定。",
  "semantic_shift": "从一块具体的地面，扩展到有边界的地区；再用于抽象的研究或工作领域。",
  "senses": [
    {
      "id": 1,
      "part_of_speech": "n.",
      "en_definition": "a particular part of a place",
      "zh_definition": "某个地方的一片区域",
      "usages": [
        {
          "usage_label": "地区",
          "collocations": [
            {
              "phrase": "a quiet area",
              "translation": "安静的区域"
            },
            {
              "phrase": "the local area",
              "translation": "当地地区"
            }
          ],
          "examples": [
            {
              "en": "This area is quiet at night.",
              "zh": "这一带夜里很安静。"
            },
            {
              "en": "Many families live in the area.",
              "zh": "许多家庭住在这一带。"
            }
          ]
        }
      ],
      "synonyms": [
        "region：常指较大的地区；area 大小更灵活。"
      ],
      "antonyms": [],
      "confusables": [
