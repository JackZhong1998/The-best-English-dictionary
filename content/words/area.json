      ]
    },
    {
      "id": 2,
      "part_of_speech": "n.",
      "en_definition": "the size of a surface",
      "zh_definition": "平面所占的大小",
      "usages": [
        {
          "usage_label": "面积",
          "collocations": [
            {
              "phrase": "measure the area",
              "translation": "测量面积"
            },
            {
              "phrase": "a large area",
              "translation": "大面积"
            }
          ],
          "examples": [
            {
              "en": "We measured the area of the room.",
              "zh": "我们测量了房间的面积。"
            },
            {
              "en": "The park covers a large area.",
              "zh": "这座公园占地很广。"
            }
          ]
        }
      ],
      "synonyms": [
        "size：泛指大小；area 专指平面的面积。"
      ],
      "antonyms": [],
      "confusables": [
