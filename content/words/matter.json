            {
              "phrase": "does it matter",
              "translation": "这重要吗"
            }
          ],
          "examples": [
            {
              "en": "Your words matter.",
              "zh": "你的话很重要。"
            },
            {
              "en": "It does not matter now.",
              "zh": "现在这不重要。"
            }
          ]
        }
      ],
      "synonyms": [
