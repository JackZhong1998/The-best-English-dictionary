  "etymology": "源自古英语 rinnan，早期表示“跑、流动”。",
  "semantic_shift": "从快速移动延伸到液体流动、机器运转和事务运行；短语动词还会产生新的具体义。",
  "senses": [
    {
      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to move quickly on foot",
      "zh_definition": "用双脚快速移动",
      "usages": [
        {
          "usage_label": "奔跑",
          "collocations": [
            {
              "phrase": "run fast",
              "translation": "跑得快"
            },
            {
              "phrase": "run to school",
              "translation": "跑去学校"
            }
          ],
          "examples": [
            {
              "en": "I run every morning.",
              "zh": "我每天早上跑步。"
            },
            {
              "en": "The dog ran across the yard.",
              "zh": "狗跑过院子。"
            }
          ]
        }
      ],
      "synonyms": [
