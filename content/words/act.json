            {
              "phrase": "a brave act",
              "translation": "勇敢的举动"
            }
          ],
          "examples": [
            {
              "en": "Helping her was an act of kindness.",
              "zh": "帮助她是一次善举。"
            },
            {
              "en": "The rescue was a brave act.",
              "zh": "这次救援是勇敢的举动。"
            }
          ]
        }
      ],
      "synonyms": [
        "action：泛指行动；act 常指可单独评价的一件行为。"
      ],
      "antonyms": [],
      "confusables": [
