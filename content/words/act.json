    {
      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to do something in response to a situation",
      "zh_definition": "面对情况采取行动",
      "usages": [
        {
          "usage_label": "行动",
          "collocations": [
            {
              "phrase": "act quickly",
              "translation": "迅速行动"
            },
            {
              "phrase": "act on advice",
              "translation": "根据建议行动"
            }
          ],
          "examples": [
            {
              "en": "We must act quickly to help them.",
              "zh": "我们必须迅速行动帮助他们。"
            },
            {
              "en": "She acted on her doctor's advice.",
              "zh": "她按医生的建议采取了行动。"
            }
          ]
        }
      ],
      "synonyms": [
        "respond：强调作出回应；act 强调真正采取行动。"
      ],
      "antonyms": [
        "do nothing：不采取行动。"
      ],
      "confusables": [
        "act on advice 是照建议行动，不是表演建议。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to perform as a character in a play or film",
      "zh_definition": "在戏剧或电影中扮演角色",
      "usages": [
        {
          "usage_label": "表演",
          "collocations": [
            {
              "phrase": "act in a film",
              "translation": "参演电影"
            },
            {
              "phrase": "act on stage",
              "translation": "在舞台上表演"
            }
          ],
          "examples": [
            {
              "en": "He acted in a school play.",
              "zh": "他参演了学校的话剧。"
            },
            {
              "en": "She has acted on stage for years.",
              "zh": "她在舞台上表演多年了。"
            }
          ]
        }
      ],
      "synonyms": [
        "perform：泛指演出；act 特指扮演角色。"
      ],
      "antonyms": [],
      "confusables": [
        "act in a film 指参演，不是对电影采取行动。"
      ]
    },
    {
      "id": 3,
      "part_of_speech": "n.",
      "en_definition": "a particular thing that someone does",
