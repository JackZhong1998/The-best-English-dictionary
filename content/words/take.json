            {
              "phrase": "take it home",
              "translation": "把它带回家"
            }
          ],
          "examples": [
            {
              "en": "Take your bag with you.",
              "zh": "带上你的包。"
            },
            {
              "en": "She took the book home.",
              "zh": "她把书带回家了。"
            }
          ]
        }
      ],
      "synonyms": [
