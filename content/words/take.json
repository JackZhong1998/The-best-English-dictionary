      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to pick up and carry something",
      "zh_definition": "拿起并带走某物",
      "usages": [
        {
          "usage_label": "拿或带走",
          "collocations": [
            {
              "phrase": "take a bag",
