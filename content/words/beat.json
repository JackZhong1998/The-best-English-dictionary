            {
              "phrase": "beat someone in a race",
              "translation": "在赛跑中胜过某人"
            }
          ],
          "examples": [
            {
              "en": "Our team beat theirs by two points.",
              "zh": "我们队以两分优势打败了他们队。"
            },
