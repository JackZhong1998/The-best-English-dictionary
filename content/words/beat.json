      ],
      "antonyms": [],
      "confusables": [
        "beat a drum 是敲鼓，不是打败鼓。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to defeat someone in a game or competition",
      "zh_definition": "在比赛中战胜某人",
      "usages": [
        {
          "usage_label": "打败",
          "collocations": [
            {
