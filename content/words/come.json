{
  "word": "come",
  "phonetic": "/kʌm/",
  "syllables": [
    "come"
  ],
  "pos": [
    "v."
  ],
  "core_meanings": [
    "来",
    "到达",
    "发生"
  ],
  "etymology": "源自古英语 cuman，意为“来、到达”。",
  "semantic_shift": "以说话人或目标地点为中心，表示“来到”；再扩展为时间、事件或问题“到来”。",
  "senses": [
    {
      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to move toward the speaker or a place",
      "zh_definition": "朝说话人或某地移动",
      "usages": [
        {
          "usage_label": "来或到来",
          "collocations": [
            {
              "phrase": "come here",
              "translation": "到这里来"
            },
            {
              "phrase": "come home",
              "translation": "回家"
            }
          ],
          "examples": [
            {
              "en": "Please come here.",
              "zh": "请到这里来。"
            },
            {
              "en": "She came home late.",
              "zh": "她回家晚了。"
            }
          ]
        }
      ],
      "synonyms": [
        "arrive：强调到达；come 强调朝说话人或目标地点移动。"
      ],
      "antonyms": [
        "go：从说话人所在处离开。"
      ],
      "confusables": [
        "come here 要朝说话人来；go there 是去别处。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to reach a place or point",
      "zh_definition": "到达某处或某阶段",
      "usages": [
        {
          "usage_label": "到达",
          "collocations": [
            {
              "phrase": "come first",
              "translation": "获得第一"
            },
            {
              "phrase": "come to an end",
              "translation": "结束"
            }
          ],
          "examples": [
            {
              "en": "Our team came first.",
              "zh": "我们队得了第一。"
            },
            {
              "en": "The show came to an end.",
              "zh": "演出结束了。"
            }
          ]
        }
      ],
      "synonyms": [
        "reach：强调抵达某处或达到某阶段。"
      ],
      "antonyms": [
        "leave：离开。"
      ],
      "confusables": [
        "come first 是得第一，不是第一个来到这里。"
      ]
    },
    {
      "id": 3,
      "part_of_speech": "v.",
      "en_definition": "to happen or become available",
      "zh_definition": "发生或出现",
      "usages": [
        {
          "usage_label": "到来或出现",
          "collocations": [
            {
              "phrase": "come soon",
              "translation": "很快到来"
            },
            {
              "phrase": "come up",
              "translation": "出现"
            }
          ],
          "examples": [
            {
              "en": "Winter comes soon.",
              "zh": "冬天快到了。"
            },
            {
              "en": "A new problem came up.",
              "zh": "出现了一个新问题。"
            }
          ]
        }
      ],
      "synonyms": [
        "appear：强调出现；come up 常用于问题或机会出现。"
      ],
      "antonyms": [
        "disappear：消失。"
      ],
      "confusables": [
        "come up 是出现；come back 是回来。"
      ]
    },
    {
      "id": 4,
      "part_of_speech": "v.",
      "en_definition": "to go with someone",
      "zh_definition": "与某人一起去",
      "usages": [
        {
          "usage_label": "跟着来",
          "collocations": [
            {
              "phrase": "come along",
              "translation": "一起来"
            },
            {
              "phrase": "come with me",
              "translation": "跟我来"
            }
          ],
          "examples": [
            {
              "en": "Come along with us.",
              "zh": "跟我们一起来吧。"
            },
            {
              "en": "Can you come with me?",
              "zh": "你能跟我一起来吗？"
            }
          ]
        }
      ],
      "synonyms": [
        "join：加入别人；come along 常是邀请一起来。"
      ],
      "antonyms": [
        "stay behind：留下不同行。"
      ],
      "confusables": [
        "come with me 是跟我来；go with him 是跟他去。"
      ]
    },
    {
      "id": 5,
      "part_of_speech": "v.",
      "en_definition": "to return to a place",
      "zh_definition": "回到某地",
      "usages": [
        {
          "usage_label": "回来",
          "collocations": [
            {
              "phrase": "come back soon",
              "translation": "快点回来"
            },
            {
              "phrase": "come back home",
              "translation": "回家来"
            }
          ],
          "examples": [
            {
              "en": "Please come back soon.",
              "zh": "请快点回来。"
            },
            {
              "en": "He came back at night.",
              "zh": "他晚上回来了。"
            }
          ]
        }
      ],
      "synonyms": [
        "return：返回；come back 强调回到说话人关注的地方。"
      ],
      "antonyms": [
        "go away：离开。"
      ],
      "confusables": [
        "come back 是回来；get back 也可表示回来。"
      ]
    },
    {
      "id": 6,
      "part_of_speech": "v.",
      "en_definition": "to have a particular origin",
      "zh_definition": "来自某个地方",
      "usages": [
        {
          "usage_label": "来自",
          "collocations": [
            {
              "phrase": "come from China",
              "translation": "来自中国"
            },
            {
              "phrase": "come from a farm",
              "translation": "来自农场"
            }
          ],
          "examples": [
            {
              "en": "She comes from Shanghai.",
              "zh": "她来自上海。"
            },
            {
              "en": "This milk comes from a farm.",
              "zh": "这牛奶来自一家农场。"
            }
          ]
        }
      ],
      "synonyms": [
        "be from：表示来源，语气更直接。"
      ],
      "antonyms": [],
      "confusables": [
        "come from 表示来自；come to 常表示来到或达到。"
      ]
    }
  ]
}
