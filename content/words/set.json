              "phrase": "set a goal",
              "translation": "定目标"
            }
          ],
          "examples": [
            {
              "en": "We set a time for the meeting.",
              "zh": "我们定了开会时间。"
            },
            {
              "en": "He set a new goal.",
              "zh": "他定了一个新目标。"
            }
          ]
        }
      ],
