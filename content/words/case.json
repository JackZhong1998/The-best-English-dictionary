      ]
    },
    {
      "id": 5,
      "part_of_speech": "n.",
      "en_definition": "a possible event or situation",
      "zh_definition": "可能发生的情况",
      "usages": [
        {
          "usage_label": "以防某种情况",
          "collocations": [
            {
              "phrase": "in case of rain",
              "translation": "如果下雨"
            },
            {
              "phrase": "just in case",
              "translation": "以防万一"
            }
          ],
          "examples": [
            {
              "en": "Take an umbrella just in case.",
              "zh": "带把伞以防万一。"
            },
            {
              "en": "In case of rain, stay inside.",
              "zh": "如果下雨，就待在室内。"
            }
          ]
        }
      ],
      "synonyms": [
        "if：表示如果；in case 更强调预防可能发生的事。"
      ],
      "antonyms": [],
