  "syllables": [
    "a",
    "mount"
  ],
  "pos": [
    "n.",
    "v."
  ],
  "core_meanings": [
    "数量",
    "总额",
    "总计达到",
    "相当于"
  ],
  "etymology": "源自古法语 amonter“向上升”；英语中的名词“数量、总额”由动词发展。",
  "semantic_shift": "从数量逐渐升高到某个点，发展为总计达到一个数；这个结果也可以比喻为相当于某种行为。",
  "senses": [
    {
      "id": 1,
      "part_of_speech": "n.",
      "en_definition": "a quantity of something",
      "zh_definition": "某种事物的数量",
      "usages": [
        {
          "usage_label": "数量",
          "collocations": [
            {
              "phrase": "a large amount of water",
              "translation": "大量的水"
            },
            {
              "phrase": "a small amount of time",
              "translation": "一点时间"
            }
          ],
          "examples": [
            {
              "en": "Use a small amount of salt.",
              "zh": "用少量盐。"
            },
            {
              "en": "The amount of rain surprised us.",
              "zh": "降雨量让我们感到意外。"
            }
          ]
        }
      ],
      "synonyms": [
        "quantity：也指数量；amount 常搭配不可数名词。"
      ],
      "antonyms": [
        "none：一点也没有。"
      ],
      "confusables": [
        "a number of 后接可数名词复数；an amount of 常接不可数名词。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "n.",
      "en_definition": "a total sum of money",
      "zh_definition": "钱款的总额",
      "usages": [
        {
          "usage_label": "金额",
          "collocations": [
            {
              "phrase": "the total amount",
              "translation": "总金额"
            },
            {
              "phrase": "an amount due",
              "translation": "应付金额"
            }
          ],
          "examples": [
            {
              "en": "Please check the amount on the bill.",
              "zh": "请核对账单上的金额。"
            },
            {
              "en": "The full amount is due tomorrow.",
              "zh": "全款明天到期。"
            }
          ]
        }
      ],
      "synonyms": [
        "sum：可指一笔钱；amount 更强调合计后的数额。"
      ],
      "antonyms": [],
      "confusables": [
        "amount 在账单里通常是“金额”，不是物品的数量。"
      ]
    },
    {
      "id": 3,
      "part_of_speech": "v.",
      "en_definition": "to add up to a total",
      "zh_definition": "合计达到某个数额",
      "usages": [
        {
          "usage_label": "总计达到",
          "collocations": [
            {
              "phrase": "amount to $100",
              "translation": "总计一百美元"
            },
            {
              "phrase": "amount to several hours",
              "translation": "总共持续几个小时"
            }
          ],
          "examples": [
            {
              "en": "The costs amount to $100.",
              "zh": "费用总计一百美元。"
            },
            {
              "en": "The delays amounted to several hours.",
              "zh": "延误总共持续了好几个小时。"
            }
          ]
        }
      ],
      "synonyms": [
        "total：直接表示总计；amount to 强调加起来达到某个数。"
      ],
      "antonyms": [
        "fall short of：没有达到某个总数。"
      ],
      "confusables": [
        "amount to 后接总数或程度，不直接接宾语。"
      ]
    },
    {
      "id": 4,
      "part_of_speech": "v.",
      "en_definition": "to be effectively the same as something",
      "zh_definition": "实际上相当于某事",
      "usages": [
        {
          "usage_label": "相当于",
          "collocations": [
            {
              "phrase": "amount to a refusal",
              "translation": "等于拒绝"
            },
            {
              "phrase": "amount to a promise",
              "translation": "等于作出承诺"
            }
          ],
          "examples": [
            {
              "en": "His silence amounted to a refusal.",
              "zh": "他的沉默等于拒绝。"
            },
            {
              "en": "That answer amounts to a promise.",
              "zh": "那个回答等于作出了承诺。"
            }
          ]
        }
      ],
      "synonyms": [
        "be equivalent to：更明确地表示等同；amount to 常指实际效果。"
      ],
      "antonyms": [
        "differ from：与某事不同。"
      ],
      "confusables": [
        "此义的 amount to 不表示具体金额。"
      ]
    }
  ]
}
