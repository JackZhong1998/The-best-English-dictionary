{
  "word": "go",
  "phonetic": "/ɡoʊ/",
  "syllables": [
    "go"
  ],
  "pos": [
    "v."
  ],
  "core_meanings": [
    "去",
    "运行",
    "变得"
  ],
  "etymology": "源自古英语 gān，基本义为“走、去”。",
  "semantic_shift": "从移动、离开扩展到事情“进行”；go bad 等结构表示进入某种状态。",
  "senses": [
    {
      "id": 1,
      "part_of_speech": "v.",
      "en_definition": "to move or travel to another place",
      "zh_definition": "移动或前往另一个地方",
      "usages": [
        {
          "usage_label": "去",
          "collocations": [
            {
              "phrase": "go home",
              "translation": "回家"
            },
            {
              "phrase": "go to school",
              "translation": "去学校"
            }
          ],
          "examples": [
            {
              "en": "I go to school by bus.",
              "zh": "我坐公交车上学。"
            },
            {
              "en": "Let's go home.",
              "zh": "我们回家吧。"
            }
          ]
        }
      ],
      "synonyms": [
        "travel：前往；go 是最常用的移动动词。"
      ],
      "antonyms": [
        "come：朝说话人来。"
      ],
      "confusables": [
        "go 强调离开当前地点；come 强调来到目标地点。"
      ]
    },
    {
      "id": 2,
      "part_of_speech": "v.",
      "en_definition": "to leave a place",
      "zh_definition": "离开某地",
      "usages": [
        {
          "usage_label": "走或离开",
          "collocations": [
            {
              "phrase": "go now",
              "translation": "现在走"
            },
            {
              "phrase": "go away",
              "translation": "离开"
            }
          ],
          "examples": [
            {
              "en": "I must go now.",
              "zh": "我现在必须走了。"
            },
            {
              "en": "The bird went away.",
              "zh": "鸟离开了。"
            }
          ]
        }
      ],
      "synonyms": [
        "leave：离开；go away 强调从这里走开。"
      ],
      "antonyms": [
        "stay：留下。"
      ],
      "confusables": [
        "go away 是走开；get away 常强调脱身。"
      ]
    },
    {
      "id": 3,
      "part_of_speech": "v.",
      "en_definition": "to happen in a particular way",
      "zh_definition": "以某种方式进行",
      "usages": [
        {
          "usage_label": "进展",
          "collocations": [
            {
              "phrase": "go well",
              "translation": "进展顺利"
            },
            {
              "phrase": "go badly",
              "translation": "进展不顺"
            }
          ],
          "examples": [
            {
              "en": "The meeting went well.",
              "zh": "会议进行得很顺利。"
            },
            {
              "en": "How did the exam go?",
              "zh": "考试进行得怎么样？"
            }
          ]
        }
      ],
      "synonyms": [
        "proceed：按某种方式进行；go 常搭配 well、badly。"
      ],
      "antonyms": [
        "stop：停止。"
      ],
      "confusables": [
        "How did it go? 问的是事情进展，不是它去了哪里。"
      ]
    },
    {
      "id": 4,
      "part_of_speech": "v.",
      "en_definition": "to become or turn into a state",
      "zh_definition": "进入某种状态",
      "usages": [
        {
          "usage_label": "变得",
          "collocations": [
            {
              "phrase": "go bad",
              "translation": "变质"
            },
            {
              "phrase": "go quiet",
              "translation": "安静下来"
            }
          ],
          "examples": [
            {
              "en": "The milk went bad.",
              "zh": "牛奶变质了。"
            },
            {
              "en": "The room went quiet.",
              "zh": "房间安静下来了。"
            }
          ]
        }
      ],
      "synonyms": [
        "become：变成某种状态；go 常搭配 bad、quiet 等。"
      ],
      "antonyms": [
        "remain：保持原样。"
      ],
      "confusables": [
        "go bad 是变质；be bad 是已经不好。"
      ]
    },
    {
      "id": 5,
      "part_of_speech": "v.",
      "en_definition": "to be suitable or match",
      "zh_definition": "适合或相配",
      "usages": [
        {
          "usage_label": "搭配",
          "collocations": [
            {
              "phrase": "go with",
              "translation": "与……相配"
            },
            {
              "phrase": "go together",
              "translation": "搭配得好"
            }
          ],
          "examples": [
            {
              "en": "This shirt goes with your jeans.",
              "zh": "这件衬衫和你的牛仔裤很搭。"
            },
            {
              "en": "Red and white go together.",
              "zh": "红色和白色很搭。"
            }
          ]
        }
      ],
      "synonyms": [
        "match：相配；go with 是常见搭配。"
      ],
      "antonyms": [
        "clash：颜色或风格不搭。"
      ],
      "confusables": [
        "go with a shirt 可以是搭配衬衫，也可能是和穿衬衫的人同行。"
      ]
    },
    {
      "id": 6,
      "part_of_speech": "v.",
      "en_definition": "to continue or happen",
      "zh_definition": "继续或进行",
      "usages": [
        {
          "usage_label": "继续",
          "collocations": [
            {
              "phrase": "go on",
              "translation": "继续"
            },
            {
              "phrase": "go on with work",
              "translation": "继续工作"
            }
          ],
          "examples": [
            {
              "en": "The show went on.",
              "zh": "演出继续了。"
            },
            {
              "en": "Please go on with your work.",
              "zh": "请继续你的工作。"
            }
          ]
        }
      ],
      "synonyms": [
        "continue：继续；go on 更口语。"
      ],
      "antonyms": [
        "stop：停止。"
      ],
      "confusables": [
        "go on 是继续；go out 是出去或灯熄灭。"
      ]
    },
    {
      "id": 7,
      "part_of_speech": "v.",
      "en_definition": "to stop shining or working",
      "zh_definition": "灯光或电源停止工作",
      "usages": [
        {
          "usage_label": "熄灭",
          "collocations": [
            {
              "phrase": "the lights go out",
              "translation": "灯灭"
            },
            {
              "phrase": "power goes out",
              "translation": "停电"
            }
          ],
          "examples": [
            {
              "en": "The lights went out.",
              "zh": "灯灭了。"
            },
            {
              "en": "The power went out last night.",
              "zh": "昨晚停电了。"
            }
          ]
        }
      ],
      "synonyms": [
        "stop working：停止工作；go out 常指灯或电源熄灭。"
      ],
      "antonyms": [
        "come on：灯或电源打开。"
      ],
      "confusables": [
        "the lights went out 是灯灭，不是灯走出房间。"
      ]
    }
  ]
}
